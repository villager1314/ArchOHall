#!/usr/bin/env bash
set -euo pipefail
prefix=/opt/archohall-kwin-compat
export LD_LIBRARY_PATH="$prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$prefix/lib/qt6/plugins"
export QML_IMPORT_PATH="$prefix/lib/qt6/qml"
export XDG_DATA_DIRS="$prefix/share:/usr/local/share:/usr/share"
unset QT_QUICK_BACKEND
export KWIN_COMPOSE=O2 LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe QSG_RHI_BACKEND=opengl
export KWIN_DISABLE_VULKAN=1 ARCHOHALL_KWIN_SHM=1
exec "$prefix/bin/kwin_wayland" "$@"
