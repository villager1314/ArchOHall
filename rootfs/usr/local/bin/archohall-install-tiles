#!/usr/bin/env bash
# Managed overrides are opt-in through the Android desktop-support installation.
set -euo pipefail
source_dir=/usr/local/share/archohall/quicksettings
target_dir=/usr/share/plasma/quicksettings
backup=/usr/local/share/archohall/quicksettings-before-005
if [[ ${1:-} == --restore ]]; then
    for directory in "$source_dir"/*; do
        name=${directory##*/}
        if [[ -d $backup/$name ]]; then
            rm -rf -- "$target_dir/$name"
            cp -a "$backup/$name" "$target_dir/$name"
        elif [[ -f $backup/$name.absent ]]; then
            rm -rf -- "$target_dir/$name"
        fi
    done
    rm -f /usr/local/share/archohall/.tiles-005
    exit
fi
mkdir -p "$target_dir" "$backup"
for directory in "$source_dir"/*; do
    [[ -f $directory/metadata.json ]] || continue
    name=${directory##*/}
    if [[ ! -e $backup/$name && ! -e $backup/$name.absent ]]; then
        if [[ -d $target_dir/$name ]]; then cp -a "$target_dir/$name" "$backup/$name"; else touch "$backup/$name.absent"; fi
    fi
    mkdir -p "$target_dir/$name"
    cp -a "$directory/." "$target_dir/$name/"
done
touch /usr/local/share/archohall/.tiles-005
