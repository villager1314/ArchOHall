#!/usr/bin/env bash
# Wayland -> Android text only; keep the existing Android -> X11 path intact.
set -euo pipefail
python3 - <<'PY'
import json
from pathlib import Path
s=json.loads(Path('/run/archohall-host/state.json').read_text())
if not s.get('clipboardWrite'):
    raise SystemExit('Android host has no clipboard-write capability')
PY
# --watch uses the compositor data-control protocol. If unsupported, report it
# instead of repeatedly spawning polling processes or changing the compositor.
exec wl-paste --type text --watch /usr/local/bin/archohall-host clipboard-set
