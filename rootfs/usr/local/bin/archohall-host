#!/usr/bin/env bash
# Only a fixed Android action name crosses this private same-app channel.
set -euo pipefail
bridge=${ARCHOHALL_HOST_BRIDGE:-/run/archohall-host}
action=${1:-}
case "$action" in
    clipboard-set)
        encoded=$(python3 -c 'import base64,sys; b=sys.stdin.buffer.read(262145); sys.exit(2) if len(b)>262144 else print(base64.b64encode(b).decode())')
        action="clipboard-set:$encoded"
        ;;
    brightness-set|volume-set)
        [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && (( 10#${2} <= 100 )) || { echo 'Invalid control value' >&2; exit 2; }
        action="$action:$2"
        ;;
esac
case "${1:-}" in
    wifi|mobiledata|bluetooth|airplane|hotspot|settings|battery|volume|brightness|power|keepawake|nightcolor|dnd|apps|clipboard-set|brightness-set|volume-set) ;;
    *) echo 'Unknown Android host action' >&2; exit 2 ;;
esac
[[ -d "$bridge/requests" ]] || { echo 'Android host bridge is not mounted' >&2; exit 1; }
request=$(mktemp "$bridge/requests/req-XXXXXXXXXXXX")
reply="$request.reply"
trap 'rm -f -- "$request" "$request.request" "$reply"' EXIT
printf '%s\n' "$action" > "$request"
mv -- "$request" "$request.request"
for ((attempt=0;attempt<40;attempt++)); do
    if [[ -f $reply ]]; then
        result=$(cat "$reply"); printf '%s\n' "$result"
        [[ $result == OK ]]; exit
    fi
    sleep 0.1
done
echo 'Android host did not acknowledge the action' >&2
exit 1
