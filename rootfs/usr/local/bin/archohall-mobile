#!/usr/bin/env bash
set -euo pipefail
if [[ $(id -u) == 0 ]]; then
    echo 'Enter the container as user arch, not root.' >&2
    exit 1
fi
export DISPLAY="${DISPLAY:-:0}"
XDG_RUNTIME_DIR="/tmp/archohall-runtime-$(id -u)"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export PULSE_SERVER="${PULSE_SERVER:-tcp:127.0.0.1}"
export KWIN_IM_SHOW_ALWAYS=1
export KWIN_DEVICE_SKIPS_INPUT_METHOD=_none_
# X11 nesting reports mouse input even when Android was touched.
if [[ -x /usr/bin/plasma-keyboard || -x /usr/bin/maliit-keyboard ]] && command -v kwriteconfig6 >/dev/null; then
    input_method=$(kreadconfig6 --file kwinrc --group Wayland --key InputMethod 2>/dev/null || true)
    if [[ -z $input_method ]]; then
        kwriteconfig6 --file kwinrc --group Wayland --key InputMethod /usr/local/share/applications/org.archohall.keyboard.desktop
    fi
fi
unset WAYLAND_DISPLAY WAYLAND_SOCKET DBUS_SESSION_BUS_ADDRESS SESSION_MANAGER
case "${ARCHOHALL_RENDERER:-software}" in
    software)
        export LIBGL_ALWAYS_SOFTWARE=1
        export GALLIUM_DRIVER=llvmpipe
        ;;
    auto) unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER ;;
    *) echo 'ARCHOHALL_RENDERER must be software or auto.' >&2; exit 2 ;;
esac
for dimension in "${ARCHOHALL_WIDTH:-720}" "${ARCHOHALL_HEIGHT:-1280}"; do
    [[ $dimension =~ ^[1-9][0-9]{1,3}$ ]] || { echo 'Invalid dimensions.' >&2; exit 2; }
done
xdpyinfo -display "$DISPLAY" >/dev/null || {
    echo 'Cannot reach Termux:X11. Start the host server and use --shared-tmp.' >&2
    exit 1
}
kwin_cmd=kwin_wayland
extra=(--xwayland)
if [[ -x /opt/archohall-kwin-compat/bin/kwin_wayland ]]; then
    kwin_cmd=/usr/local/bin/archohall-kwin-compat
    extra=()
fi
exec dbus-run-session -- "$kwin_cmd" \
    --x11-display "$DISPLAY" \
    --width "${ARCHOHALL_WIDTH:-720}" --height "${ARCHOHALL_HEIGHT:-1280}" \
    --socket wayland-archohall "${extra[@]}" \
    --exit-with-session /usr/local/bin/archohall-session
